# Transport: stdio (Claude Desktop) or http (ChatGPT / remote clients)
MCP_TRANSPORT=stdio
# HTTP transport (binds to localhost by default)
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3333
# Required when MCP_HTTP_HOST is not a loopback address. Generate with scripts/new-token.ps1 (Windows) or openssl rand -hex 24 (macOS)
MCP_AUTH_TOKEN=
# Optional: secret path segment for clients that cannot send headers (ChatGPT "No authentication")
MCP_SECRET_PATH=
# Bridge adapter: auto (COM on Windows, AppleScript on macOS), com, applescript, or mock (testing only)
ILLUSTRATOR_ADAPTER=auto
ILLUSTRATOR_TIMEOUT_MS=60000
ILLUSTRATOR_AUTO_LAUNCH=true
# Semicolon-separated directories the server may read/write. Defaults to ./output and ~/Documents/IllustratorMCP
ALLOWED_PATHS=
LOG_LEVEL=info
LOG_DIR=logs
